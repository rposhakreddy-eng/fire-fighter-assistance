# Environment Configuration for Fire Fighter Assistance Drone
# Do NOT commit your actual .env file with secrets to GitHub!

# Groq API Key for multimodal LLM vision reasoning (Optional)
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Drone Stream URL (Optional default: RTSP or HTTP endpoint)
DRONE_STREAM_URL=rtsp://192.168.1.100:554/live/ch0

# YOLO inference resolution (multiple of 32). 640 = full accuracy.
# Use 320 on low-CPU cloud instances such as Render's free plan.
# YOLO_IMG_SIZE=640

# Storage root for SQLite + annotated images (defaults to the project folder).
# FIREGUARD_DATA_DIR=

